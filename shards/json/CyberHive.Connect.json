{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://docs.cyberhive.com/connect/release-notes/",
		"regex": "href=[\"']https://pkgs\\.cyberhive\\.com/windows/stable/cyberhive-connect_(?<version>\\d+(?:\\.\\d+)+)-(?<build>[0-9a-f]+)\\.exe[\"']"
	},
	"urls": [
		{
			"url": "https://pkgs.cyberhive.com/windows/stable/cyberhive-connect_{version}-{captures.build}.exe",
			"architecture": "x64"
		}
	],
	"releaseNotes": {
		"source": "html",
		"sourceUrl": "https://docs.cyberhive.com/connect/release-notes/",
		"regex": "<h2 id=\"{version|.|}\">[\\s\\S]*?</h2>\\s*(?:<p><em>[^<]*</em></p>\\s*)?(?:<p>CyberHive Connect release [\\s\\S]*?</p>\\s*)?([\\s\\S]*?)(?=<h2\\b|</article>)",
		"releaseNotesUrl": "https://docs.cyberhive.com/connect/release-notes/#{version|.|}",
		"cleanup": false
	}
}
