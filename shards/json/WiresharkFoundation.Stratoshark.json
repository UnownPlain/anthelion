{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "sort-versions",
	"sortVersions": {
		"url": "https://2.na.dl.wireshark.org/win64/all-versions/",
		"regex": "href=[\"']Stratoshark-(\\d+(?:\\.\\d+)+)-x64\\.exe[\"']"
	},
	"urls": [
		"https://2.na.dl.wireshark.org/win64/all-versions/Stratoshark-{version}-x64.exe",
		"https://2.na.dl.wireshark.org/win64/all-versions/Stratoshark-{version}-arm64.exe"
	],
	"releaseNotes": {
		"source": "html",
		"sourceUrl": "https://stratoshark.org/docs/relnotes/stratoshark-{version}"
	}
}
