{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": ["https://links.extensis.com/extensis_connect/ec_latest?language=en&platform=win"],
		"regex": "ExtensisConnect-W-(\\d+(?:-\\d+)+)\\.zip"
	},
	"version": "{version|-|.}",
	"urls": [
		{ "url": "https://bin.extensis.com/ExtensisConnect-W-{version}.zip", "architecture": "x64" }
	],
	"releaseNotes": {
		"source": "html",
		"sourceUrl": "https://www.extensis.com/support/connect/release-notes",
		"regex": "<h3\\b[^>]*>\\s*Version {packageVersion|.|\\.}\\s*</h3>\\s*(?:<p\\b[^>]*>[^<]*\\d{4}\\s*</p>\\s*)?([\\s\\S]*?)(?=<h3\\b[^>]*>\\s*Version\\b|<h2\\b)",
		"cleanup": false
	}
}
