{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://www.epilogue.co/downloads",
		"regex": "href=.*?/v?(\\d+(?:\\.\\d+)+)/release/windows"
	},
	"urls": [
		{
			"url": "https://releases.epilogue.co/desktop/playback/{version}/release/windows/playback-setup.exe",
			"architecture": "x64"
		}
	]
}
