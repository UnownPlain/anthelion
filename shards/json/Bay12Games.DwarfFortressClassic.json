{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://bay12games.com/dwarves/dev_release.rss",
		"regex": "<title>(?<releaseDate>\\d{4}-\\d{2}-\\d{2}): DF (?<version>\\d+(?:\\.\\d+)+) Released</title>"
	},
	"urls": ["https://bay12games.com/dwarves/df_{version|.|_}_win.zip"],
	"releaseNotes": {
		"source": "html",
		"sourceUrl": "https://bay12games.com/dwarves/index.html",
		"regex": "<li id=\"{captures.releaseDate}\" class=\"dev_progress\">\\s*<span class=\"date\">[^<]+</span>\\s*<img\\b[^>]*>\\s*((?:(?!<li\\s+id=)[\\s\\S])*?)</li>\\s*<li id=\"R{captures.releaseDate}\"",
		"releaseNotesUrl": "https://bay12games.com/dwarves/index.html#{captures.releaseDate}",
		"cleanup": false
	}
}
