{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://greatis.com/stopupdates10/",
		"regex": "Version:\\s*(\\d+\\.\\d+\\.\\d{4}\\.\\d+)\\s*\\(Date:"
	},
	"urls": ["https://www.greatissoftware.com/stopupdates10.zip"],
	"replace": true,
	"releaseNotes": {
		"source": "html",
		"sourceUrl": "https://greatis.com/stopupdates10/",
		"regex": "</b>\\s*(?:<br\\s*/?>\\s*)?Version {version|.|\\.}\\s*(<ul>[\\s\\S]*?</ul>)",
		"releaseNotesUrl": "https://greatis.com/stopupdates10/#changelog",
		"cleanup": false
	}
}
