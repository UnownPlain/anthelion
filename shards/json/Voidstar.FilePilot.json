{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://filepilot.tech/download",
		"regex": "href=[\"']/starlog/(?<date>\\d{4}-\\d{2}-\\d{2})-v(?<version>\\d+(?:\\.\\d+)+)[\"'][^>]*class=[\"']download-version[\"']"
	},
	"urls": ["https://filepilot.tech/download/v{version}"],
	"releaseNotes": {
		"source": "html",
		"sourceUrl": "https://filepilot.tech/starlog/{captures.date}-v{version}"
	}
}
