{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": ["https://filepilot.tech/download/latest"],
		"regex": "/(?<date>\\d{4}-\\d{2}-\\d{2})-v(?<version>\\d+(?:\\.\\d+)+)/FPilot\\.exe"
	},
	"releaseNotes": {
		"source": "html",
		"sourceUrl": "https://filepilot.tech/starlog/{captures.date}-v{version}"
	}
}
