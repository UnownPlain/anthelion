{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": { "owner": "depot", "repo": "cli" },
	"urls": [
		"https://github.com/depot/cli/releases/download/v{version}/depot_{version}_windows_386.zip",
		"https://github.com/depot/cli/releases/download/v{version}/depot_{version}_windows_amd64.zip",
		"https://github.com/depot/cli/releases/download/v{version}/depot_{version}_windows_arm64.zip"
	]
}
