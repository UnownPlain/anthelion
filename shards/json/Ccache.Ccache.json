{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": { "owner": "ccache", "repo": "ccache" },
	"urls": [
		"https://github.com/ccache/ccache/releases/download/v{version}/ccache-{version}-windows-x86_64.zip",
		"https://github.com/ccache/ccache/releases/download/v{version}/ccache-{version}-windows-aarch64.zip"
	],
	"releaseNotes": {
		"source": "html",
		"sourceUrl": "https://ccache.dev/releasenotes.html#_ccache_{version|.|_}",
		"regex": "<h2 id=\"_ccache_{version|.|_}\">(?:<a\\b[^>]*></a>)?[^<]*</h2>\\s*<div class=\"sectionbody\">\\s*<div class=\"paragraph\">\\s*<p>Release date:[^<]*</p>\\s*</div>([\\s\\S]*?)(?=<div class=\"sect1\">|<div id=\"footer\">)",
		"cleanup": false
	}
}
