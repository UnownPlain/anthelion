{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "d4vid87",
		"repo": "hookecho",
		"method": "api-latest"
	},
	"urls": [
		"https://github.com/d4vid87/hookecho/releases/download/{github.rawTag}/HookEcho-x86_64.msi",
		"https://github.com/d4vid87/hookecho/releases/download/{github.rawTag}/HookEcho-setup-x86_64.exe",
		{
			"url": "https://github.com/d4vid87/hookecho/releases/download/{github.rawTag}/hookecho-windows-x86_64.zip",
			"nestedInstallerMatches": ["hookecho.exe"]
		}
	],
	"version": {
		"source": "product"
	},
	"state": {
		"source": "value",
		"value": "{github.rawTag}"
	}
}
