{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": {
		"owner": "CXWorld",
		"repo": "CapFrameX"
	},
	"version": { "source": "display" },
	"state": {
		"source": "value",
		"value": "{github.rawTag}"
	},
	"urls": [
		"https://github.com/CXWorld/CapFrameX/releases/download/{github.rawTag}/release_{github.version}_installer.zip",
		{
			"url": "https://github.com/CXWorld/CapFrameX/releases/download/{github.rawTag}/release_{github.version}_portable.zip",
			"architecture": "x64"
		}
	]
}
