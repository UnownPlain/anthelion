{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "github-release",
	"github": { "owner": "peazip", "repo": "PeaZip" },
	"urls": [
		"https://github.com/peazip/PeaZip/releases/download/{version}/peazip-{version}.WIN64.exe",
		{
			"url": "https://github.com/peazip/PeaZip/releases/download/{version}/peazip-{version}.WINDOWS.exe",
			"architecture": "x86"
		},
		"https://github.com/peazip/PeaZip/releases/download/{version}/peazip_portable-{version}.WIN64.zip",
		{
			"url": "https://github.com/peazip/PeaZip/releases/download/{version}/peazip_portable-{version}.WINDOWS.zip",
			"architecture": "x86"
		}
	]
}
