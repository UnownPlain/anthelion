{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://cdn.mikrotik.com/routeros/latest-stable.rss",
		"regex": "<title>RouterOS\\s+v?(\\d+(?:\\.\\d+)+)"
	},
	"urls": ["https://download.mikrotik.com/routeros/{version}/dude-install-{version}.exe"],
	"releaseNotes": {
		"source": "plain-text",
		"sourceUrl": "https://download.mikrotik.com/routeros/{version}/CHANGELOG",
		"cleanup": false
	}
}
