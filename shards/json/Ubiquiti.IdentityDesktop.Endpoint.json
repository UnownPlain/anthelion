{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "redirect-match",
	"redirectMatch": {
		"url": [
			"https://fw-update.ui.com/api/v2/firmware-latest/data?filter=eq~~product~~uid-identity-standard-desktop-app-msi&filter=eq~~platform~~windows&filter=eq~~channel~~release"
		],
		"regex": "/uid-identity-standard-desktop-app-msi/[a-f0-9]+-windows-(\\d+(?:\\.\\d+)+)-[a-f0-9-]+\\.msi$"
	}
}
