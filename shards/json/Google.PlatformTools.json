{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://dl.google.com/android/repository/repository2-1.xml",
		"regex": "path=\"platform-tools\"[\\s\\S]*?<url>platform-tools_r(\\d+(?:\\.\\d+)+)-win\\.zip<\\/url>"
	},
	"urls": [
		{
			"url": "https://dl.google.com/android/repository/platform-tools_r{version}-win.zip",
			"architecture": "x64"
		}
	],
	"releaseNotes": {
		"source": "html",
		"sourceUrl": "https://developer.android.com/tools/releases/platform-tools",
		"regex": "<h4\\b[^>]*>\\s*{version|.|\\.}(?:\\s+\\([^<]*\\))?\\s*</h4>([\\s\\S]*?)(?=<h[234]\\b|</article>|</devsite-content-footer>)",
		"cleanup": false
	}
}
